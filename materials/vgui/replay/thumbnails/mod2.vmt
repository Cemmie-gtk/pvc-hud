"Modulate"
{
	"$baseTexture" "vgui/replay/thumbnails/mod"
	"$vertexalpha" 1
	"$translucent" 1
	"$additive" 1
	"$scaleamount" "[-1 1]"
	    "Proxies"
		{
			   "TextureTransform"
	          {
                                             "scaleVar" "$scaleamount"
                                             "resultVar" "$basetexturetransform"	          
              }
     }
}